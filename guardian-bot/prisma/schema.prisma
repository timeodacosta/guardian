generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://termiprotector:18Timeo77860-2006_alwaysdata@mysql-termiprotector.alwaysdata.net:3306/termiprotector_bdd"
}

model Guild {
  id             String          @id
  name           String
  ticketConfig   TicketConfig?
  antiSpamConfig AntiSpamConfig?
  antiLinkConfig AntiLinkConfig?
  welcomeConfig  WelcomeConfig?
  logsConfig     LogsConfig?
  warnConfig     WarnConfig?     
  tickets        Ticket[]
  warns          Warn[]
  bans           Ban[]
}

model TicketConfig {
  id                String  @id @default(uuid())
  guildId           String  @unique
  guild             Guild   @relation(fields: [guildId], references: [id])
  embedPayload      Json?
  buttonLabel       String  @default("Ouvrir un ticket")
  buttonStyle       String  @default("Primary")
  ticketEmbedPayload Json?
  adminRole         String?
  showClaimBtn      Boolean @default(true)
  showTranscriptBtn Boolean @default(true)
}

model Ticket {
  id         Int      @id @default(autoincrement())
  guildId    String
  userId     String
  channelId  String
  status     String   @default("OPEN")
  transcript String?  @db.Text
  createdAt  DateTime @default(now())
  guild      Guild    @relation(fields: [guildId], references: [id])
}

model Warn {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  userTag   String
  modId     String
  modTag    String
  reason    String   @db.Text
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id])
}

model Ban {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  userTag   String
  userAvatar String? // On stocke l'avatar au moment du ban pour l'affichage
  modId     String
  modTag    String
  reason    String   @db.Text
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id])
}

model AntiSpamConfig {
  id               String  @id @default(uuid())
  guildId          String  @unique
  guild            Guild   @relation(fields: [guildId], references: [id])
  enabled          Boolean @default(false)
  
  // NOUVEAUX CHAMPS
  ignoredChannelIds Json?  // Liste des IDs des salons ignorés [cite: 1]
  ignoredRoleIds    Json?  // Liste des IDs des rôles ignorés [cite: 2]
  messageLimit      Int    @default(5)    // Nombre de messages autorisés [cite: 3]
  timeWindow        Int    @default(5000) // Temps en ms (ex: 5000 = 5s) [cite: 4]
}

model AntiLinkConfig {
  id      String  @id @default(uuid())
  guildId String  @unique
  guild   Guild   @relation(fields: [guildId], references: [id])
  enabled Boolean @default(false)
}

model WelcomeConfig {
  id        String  @id @default(uuid())
  guildId   String  @unique
  guild     Guild   @relation(fields: [guildId], references: [id])
  enabled   Boolean @default(false)
  channelId String?
}

model LogsConfig {
  id        String  @id @default(uuid())
  guildId   String  @unique
  guild     Guild   @relation(fields: [guildId], references: [id])
  enabled   Boolean @default(false)
  channelId String?
}

model WarnConfig {
  id             String  @id @default(uuid())
  guildId        String  @unique
  guild          Guild   @relation(fields: [guildId], references: [id])
  dmUser         Boolean @default(true)
  autoKickCount  Int     @default(0)
  autoBanCount   Int     @default(0)
  logChannelId   String?
}